<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

<!-- идентификатор группы/организации  -->
  <groupId>com.labs</groupId>
  <!--  имя проекта (артефакта) -->
  <artifactId>labtwo</artifactId>
  <!--версия суффикс SNAPSHOT означает версию в разработке -->
  <version>1.0-SNAPSHOT</version>
  <!--  тип результата сборки. war - веб-приложение  -->
  <packaging>war</packaging>

  <name>labtwo Maven Webapp</name>
  <!-- ссылка на сайт (репозиторий проекта)-->
  <url>https://github.com/niki-sketch/Web/tree/main/labtwo</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
  </properties>

  <!-- Зависимости проекта -->
  <dependencies>
    <dependency>
       <!-- JUnit нужен для тестирования кода -->
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.11</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Настройки сборки проекта -->
  <build>
    <finalName>labtwo</finalName>
    <pluginManagement><!-- lock down plugins versions to avoid using Maven defaults (may be moved to parent pom) -->
      <plugins>
        <plugin>
          <!-- Удаляет старые файлы сборки -->
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.1.0</version>
        </plugin>
        <!-- see http://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_war_packaging -->
        <plugin>
          <!-- Копирует ресурсы проекта -->
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <!-- Компилирует Java-код -->
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.8.0</version>
        </plugin>
        <plugin>
          <!-- Запускает тесты -->
          <artifactId>maven-surefire-plugin</artifactId>
          <version>2.22.1</version>
        </plugin>
        <plugin>
          <!-- Собирает WAR-файл -->
          <artifactId>maven-war-plugin</artifactId>
          <version>3.2.2</version>
        </plugin>
        <plugin>
         <!-- Устанавливает проект в локальный репозиторий -->
          <artifactId>maven-install-plugin</artifactId>
          <version>2.5.2</version>
        </plugin>
        <plugin>
          <!-- Публикует проект в удалённый репозиторий -->
          <artifactId>maven-deploy-plugin</artifactId>
          <version>2.8.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
